# ---------------------------------------------------------------------------
# OPTIONAL - only needed for the SharePoint online mode (--score-sharepoint).
# Local folder / Excel / single-file modes do not need these values.
#
# Copy this file to ".env" and fill in the real tenant/app/workbook values.
# Do not put real secrets in this example file or in a shareable zip.
#
# App-only auth (client credentials) is headless: no browser login and no
# per-user session. Create an Entra ID app registration and admin-consent the
# Microsoft Graph application permissions below:
#
# - Sites.ReadWrite.All
# - Files.ReadWrite.All
# - Mail.Send
# - Mail.ReadWrite only if you use sent-mail/audit verification scripts
# ---------------------------------------------------------------------------

# Real tenant GUID. Do not use "common" for client-credentials auth.
TENANT_ID=00000000-0000-0000-0000-000000000000
CLIENT_ID=00000000-0000-0000-0000-000000000000
CLIENT_SECRET=your-client-secret-value

# Phase 1 SharePoint site + workbook. These must match the P1 flow outputs.
SHAREPOINT_HOSTNAME=led1234567.sharepoint.com
SHAREPOINT_SITE_PATH=/sites/CandidateList_HiringAgent
SHAREPOINT_TABLE=HiringAgent_P1_Candidates
SHAREPOINT_RESUMES_FOLDER=/Candidate_Resumes

# Optional: pin a specific workbook path. Current P1/P2 layout keeps the
# master workbook outside the resume folder so the resume tree stays clean.
# If omitted, P2 uses the same Master_Files default.
SHAREPOINT_WORKBOOK=/Master_Files/Sharepoint_Master_File.xlsx

# Mailbox used for P2 scoring-stage mail: non-USA declines and missing-info
# requests. Requires Mail.Send application permission and mailbox access.
SENDER_MAILBOX=apply@driverai.io

# Keep enabled for live P2. Set false only for intentional no-decline / no-admin-alert runs.
# NOTE: these two cover the non-USA decline and the admin failure alert ONLY. The
# missing-info / current-location nudge has no flag of its own - it fires whenever a scored
# row has a gap - so these two alone do NOT silence P2. Use HIRING_SUPPRESS_EMAILS below.
HIRING_GEO_REJECT_EMAIL=true
HIRING_ERROR_EMAIL=true

# MASTER kill-switch for EVERY outbound P2 email (declines, missing-info nudges, admin
# alerts). The P2 counterpart of P1's flow_config.json test_mode.suppress_emails. Enforced
# inside SharePointClient.send_mail(), the single function every sender calls, so no code
# path can bypass it. Scoring, row patches, resume moves, sheet reconciliation and the
# client export all continue to run normally; rows touched while suppressed are stamped
# 'TEST-MODE (suppressed) <ts>' instead of 'Sent <ts>'.
# Set true for a historical replay; set back to false afterwards or real applicants get
# silence. Also settable in config.yaml as test_mode.suppress_emails.
# DEFAULTS TO true ON PURPOSE (2026-09-11). A fresh checkout must not be one command
# away from mailing real job applicants. The committed config.yaml posture is suppressed,
# and test_p2.py asserts the two agree - shipping this as false made a clean clone fail
# that assertion and, worse, made the README's own setup steps produce a configuration
# that sends live applicant mail. Flip it to false deliberately, never by default.
HIRING_SUPPRESS_EMAILS=true

# USA-only location filter. Keep true for the current DriverAI flow.
HIRING_GEO_USA_ONLY=true

# ── Storage backend ───────────────────────────────────────────────────────────
# Where P2 keeps candidate state. THIS IS THE MOST CONSEQUENTIAL LINE IN THIS FILE.
#   sqlite : the local-first pipeline. candidates.db is the source of truth; P1's
#            workbook is READ ONLY, and results reach SharePoint as two separate
#            published files (P2-MasterFile.xlsx, Candidate_List_Results.xlsx).
#            This is what the desktop deployment runs.
#   excel  : the legacy path. Every candidate write goes straight into P1's live
#            Sharepoint_Master_File.xlsx, and the whole-table missing-field sweep runs
#            several times per run. Kept for the Azure Functions deploy.
# Unset means 'excel'. An UNRECOGNISED value is refused outright (see
# hiring_agent/store.py storage_backend) rather than silently falling back to excel -
# a typo here used to point every write at the live workbook while looking correct.
HIRING_STORAGE_BACKEND=sqlite
